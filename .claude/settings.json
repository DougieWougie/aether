{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gradle-wait.sh",
            "timeout": 600,
            "statusMessage": "Checking for running Gradle builds..."
          }
        ]
      }
    ]
  }
}
